{
  "name": "VeRL Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/conversation2SQL",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    // Installs the latest version of uv
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "remoteEnv": {
    "UV_PROJECT_ENVIRONMENT": "/workspaces/conversation2SQL/.venv",
    "UV_CACHE_DIR":    "/mnt/data1/uv-cache",
    "HF_HOME":         "/mnt/data1/huggingface",
    "TORCH_HOME":      "/mnt/data1/torch",
    "PIP_CACHE_DIR":   "/mnt/data1/pip-cache",
    "WANDB_CACHE_DIR": "/mnt/data1/wandb-cache",
    "TRITON_CACHE_DIR": "/mnt/data1/triton-cache",
    "UV_LINK_MODE": "copy"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "meta.pyrefly"
      ]
      // "settings": {
      //   "python.defaultInterpreterPath": "/opt/venv/bin/python3"
      // }
    }
  },
  "postCreateCommand": {
    // This ensures gpustat is installed globally/to the tool path on every build
    "gpustat":    "uv pip install --system gpustat",
    
    // This installs the verl package in editable mode, so that changes to the code are reflected without needing to reinstall. It is installed at system level so that it is available in the PATH and can be used as a command line tool.
    "verl_install_if_not_present": "if [ ! -d verl ]; then git clone https://github.com/volcengine/verl; fi",
    "verl_install": "cd verl && uv pip install --system --no-deps -e .",
    
    // These are the flashinfer packages, which are needed to optimize inference.
    //  They are installed at system level so that they are available in the PATH.
    // Cubin provides pre-compiled CUDA binaries (cubins) 
    // and (Just-In-Time Cache) jit-cache is used to cache the optimized kernels on disk.
    // run `flashinfer show-config` to match the same 0.6.4 version for both.
    "flashinfer": "uv pip install --system flashinfer-cubin==0.6.4 flashinfer-jit-cache==0.6.4  --extra-index-url https://flashinfer.ai/whl/cu129",
    // Installs the PostgreSQL client tools (psql, pg_isready) so they are available
    // directly in the dev container shell without needing docker exec.
    "postgresql_client": "apt-get update; apt-get install -y postgresql-client"
  }
}